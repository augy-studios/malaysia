# Secrets. The bot token and API hash live here, so this must never be committed.
.env
.env.*
!.env.example

# Telethon session files. These authenticate as the bot, so treat them as secrets.
*.session
*.session-journal
data/

# SQLite database and its write-ahead log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs, including anything piped out of the bot with tee
*.log
logs/

# OS and editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
