# Copy to .env and fill in. Never commit the real .env.

# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown as a button on /start
DONATION_URL=https://your-donation-link.example

# Optional. The bot works entirely on SQLite and does not need Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional tuning. The defaults are sensible; leave these out if unsure. ---

# Web app button target on /start
# WEB_APP_URL=https://malaysia.uwuapps.org/trains/

# Where the SQLite file and Telethon session live
# DATA_DIR=./data
# DATABASE_NAME=trains.sqlite3
# SESSION_NAME=trains-bot

# How often the GTFS static bundles are re-downloaded, in hours
# STATIC_REFRESH_HOURS=24

# How often live positions are polled for alert subscribers, in seconds
# REALTIME_POLL_SECONDS=60

# How often the scheduler checks for due notifications, in seconds
# SCHEDULER_TICK_SECONDS=30

# Upstream HTTP timeout, in seconds
# HTTP_TIMEOUT_SECONDS=30

# Radius used when someone shares their location, in metres
# NEARBY_RADIUS_METRES=2000

# Comma-separated Telegram user ids allowed to run /stats
# ADMIN_USER_IDS=
